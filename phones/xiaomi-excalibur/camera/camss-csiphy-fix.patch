+	/*
+	 * CSIPHY v1.2.2 (SM7125 / SC7180-class silicon) provenance.
+	 *
+	 * Downstream Qualcomm reference cam_csiphy_1_2_2_hwreg.h
+	 * (MiCode/Xiaomi_Kernel_OpenSource@curtana-q-oss) defines
+	 * csiphy_common_reg_1_2_2[5] as the once-global common-control
+	 * sequence executed before per-lane programming:
+	 *
+	 *   CTRLn(5)  @ 0x0814 = lane mask | CLK_ENABLE
+	 *   CTRLn(6)  @ 0x0818 = 0x01      COMMON_PWRDN_B
+	 *   CTRLn(7)  @ 0x081C = 0x02
+	 *   CTRLn(0)  @ 0x0800 = 0x02      PHY core enable
+	 *   CTRLn(33) @ 0x0884 = 0x01      terminator strobe
+	 *                                  (downstream gives no symbolic name)
+	 *
+	 * Upstream csiphy_lanes_enable() already emits the first three
+	 * via live-computed values. The last two are missing on the
+	 * SC7180 / SM7125 path: CTRLn(0) is stomped to 0x00 and CTRLn(33)
+	 * is never written. On v1.2.2 silicon this leaves the PHY top-
+	 * level clamped, so CSID sees no SOF / EOF / RX_FIFO IRQs even
+	 * with healthy MIPI traffic from the sensor (observed on Xiaomi
+	 * joyeuse, SM7125 Atoll, OV16A1Q@csiphy3 + S5K5E9@csiphy2).
+	 *
+	 * v1.2.2-byte-identical packaging exists in cam_csiphy_1_2_2_hwreg.h
+	 * (downstream) and lane_regs_sm6350 (v1.2.3) in the in-flight SM6350
+	 * v4 series; in v1.2.1 (lane_regs_sm8250) the same two writes appear
+	 * baked into the per-lane table as 5x redundant terminators. The
+	 * unconditional writes below are therefore architecturally safe for
+	 * every in-tree or in-flight v1.2.x SoC that binds csiphy_ops_3ph_1_0.
+	 *
+	 * SC7180 itself shares the same CTRLn(7)=0x02 / CTRLn(6)=PWRDN_B
+	 * prologue per downstream cam_csiphy_1_2_2_hwreg.h, which writes
+	 * the same five entries; no mainline SC7180-board streaming test
+	 * exists to confirm in-tree.
+	 */
+	val = 0x02;
 	writel_relaxed(val, csiphy->base + CSIPHY_3PH_CMN_CSI_COMMON_CTRLn(0));
 
+	writel_relaxed(0x01, csiphy->base + CSIPHY_3PH_CMN_CSI_COMMON_CTRLn(33));
+
 	if (csiphy_is_gen2(csiphy->camss->res->version))
 		csiphy_gen2_config_lanes(csiphy, settle_cnt);
 	else
