#!/bin/sh
# phone-kiosk - start a Chromium kiosk under cage on a Linux phone.
#
# greetd runs this as the phone user; output goes to ~/kiosk.log.
# The URL comes from $KIOSK_URL, the first argument, or /etc/greetd/kiosk-url.
# The scale comes from $KIOSK_SCALE (default 3).
#
# Three lessons this file encodes:
#   1. Scale in the compositor with wlr-randr, not Chromium's
#      --force-device-scale-factor: on Wayland that option renders at a
#      fractional multiple of the logical width instead of fitting the panel.
#   2. Use a whole-number scale. cage rounds the scale for Chromium, so a
#      fractional value leaves the viewport and the window mismatched.
#   3. Use --app=<url>, not a normal browser window: a browser window cannot be
#      narrower than 500 CSS px even full-screen, which overflows a 360 px
#      phone. An app window can be.
#
# Arguments:
#   [url]          page to show (default: $KIOSK_URL or /etc/greetd/kiosk-url)
#   -h, --help     show this help
#
# Changes: yes. It starts a graphical session (and ends the current one when
# launched by greetd); it also writes ~/kiosk.log.
#
# Example:
#   KIOSK_URL=https://example.com/ phone-kiosk
set -eu

usage() {
  sed -n '2,26p' "$0" | sed 's/^# \{0,1\}//'
}

case "${1:-}" in
  -h|--help) usage; exit 0 ;;
esac

URL="${1:-${KIOSK_URL:-}}"
if [ -z "$URL" ] && [ -r /etc/greetd/kiosk-url ]; then
  URL=$(cat /etc/greetd/kiosk-url)
fi
if [ -z "$URL" ]; then
  echo "phone-kiosk: set KIOSK_URL, pass a URL, or write /etc/greetd/kiosk-url" >&2
  exit 1
fi

SCALE="${KIOSK_SCALE:-3}"
case "$SCALE" in
  ''|*[!0-9]*) echo "phone-kiosk: KIOSK_SCALE must be a whole number" >&2; exit 2 ;;
esac
[ "$SCALE" -ge 1 ] || { echo "phone-kiosk: KIOSK_SCALE must be >= 1" >&2; exit 2; }

export KIOSK_URL="$URL"
export KIOSK_SCALE="$SCALE"

exec >"${KIOSK_LOG:-$HOME/kiosk.log}" 2>&1

inner=$(cat <<'INNER'
set -eu
url=$KIOSK_URL
scale=$KIOSK_SCALE

info=$(wlr-randr --json 2>/dev/null || true)
out=""
if [ -n "$info" ]; then
  out=$(printf '%s' "$info" | python3 -c '
import sys, json
d = json.load(sys.stdin)
for o in d:
    if not o.get("enabled", True):
        continue
    modes = o.get("modes") or []
    m = next((x for x in modes if x.get("current")), None)
    m = m or next((x for x in modes if x.get("preferred")), None)
    m = m or (modes[0] if modes else None)
    if m:
        print(o["name"], m["width"], m["height"])
        break
' 2>/dev/null || true)
fi

if [ -z "$out" ]; then
  out=$(wlr-randr 2>/dev/null | awk '
    /^[^ \t]/ { if (seen) exit; name=$1; seen=1 }
    /^[ \t]+[0-9]+x[0-9]+/ {
      split($1, a, "x")
      if ($0 ~ /current/) { cw=a[1]; ch=a[2]; current=1 }
      else if (!fw) { fw=a[1]; fh=a[2] }
    }
    END {
      if (current) print name, cw, ch
      else if (fw) print name, fw, fh
    }' || true)
fi

if [ -z "$out" ]; then
  echo "phone-kiosk: could not detect a wlr-randr output" >&2
  exit 1
fi

set -- $out
output=$1
w=$2
h=$3

wlr-randr --output "$output" --scale "$scale"

cw=$((w / scale))
ch=$((h / scale))

echo "kiosk: output=$output mode=${w}x${h} scale=$scale viewport=${cw}x${ch} url=$url"

exec chromium --kiosk --app="$url" --window-size="$cw,$ch" \
  --no-first-run --password-store=basic \
  --ozone-platform=wayland --touch-events=enabled \
  --enable-features=OverlayScrollbar \
  --remote-debugging-port=9222
INNER
)

exec cage -s -- sh -c "$inner"
